      { name: "Intake", phone: "0478 969 994" },
      { name: "Intake", phone: "0428 169 108" },
      { name: "Intake - District", phone: "0427 993 473" },
      { name: "SVAH", phone: "0437 111 631" },
      { name: "Vincents", phone: "92312888" },
      { name: "HITH -", phone: "0459 021 952" },
      { name: "HITH - ANUM PM", phone: "0408 366 359" },
      { name: "HITH - After Hours / On Call", phone: "0419 356 369" },
      { name: "HITH - Care", phone: "0468 666 138" },
      { name: "Corinne", phone: "0404 769 248" },
      { name: "Call", phone: "#43#" },
      { name: "Call", phone: "*43#" }
    ];

    function renderList(list) {
      const container = document.getElementById('contactList');
      document.getElementById('contactCount').innerText = list.length + " Contacts";

      if (list.length === 0) {
        container.innerHTML = '<div class="no-results">No matching contacts found.</div>';
        return;
      }

      container.innerHTML = list.map(item => {
        const cleanTel = item.phone.replace(/[^0-9+*#]/g, '');
        return `
          <div class="contact-card">
            <div class="contact-info">
              <div class="contact-name">${escapeHtml(item.name)}</div>
              <div class="contact-phone">${escapeHtml(item.phone)}</div>
            </div>
            <a href="tel:${cleanTel}" class="call-btn">
              <svg viewBox="0 0 24 24">
                <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
              </svg>
              Call
            </a>
          </div>
        `;
      }).join('');
    }

    function filterContacts() {
      const query = document.getElementById('searchInput').value.toLowerCase().trim();
      const filtered = contactsData.filter(c => 
        c.name.toLowerCase().includes(query) || c.phone.toLowerCase().includes(query)
      );
      renderList(filtered);
    }

    function toggleDrawer(forceState) {
      const drawer = document.getElementById('pullupDrawer');
      const overlay = document.getElementById('drawerOverlay');
      
      const shouldExpand = forceState !== undefined 
        ? forceState 
        : !drawer.classList.contains('expanded');

      if (shouldExpand) {
        drawer.classList.add('expanded');
        overlay.classList.add('active');
      } else {
        drawer.classList.remove('expanded');
        overlay.classList.remove('active');
      }
    }

    function escapeHtml(str) {
      return str.replace(/[&<>"']/g, match => {
        const chars = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
        return chars[match];
      });
    }

    // Initial render
    renderList(contactsData);
  </script>
</body>
</html>
